# Google Gemini API Key (Required)
GOOGLE_API_KEY=your_google_api_key_here

# LLM Configuration
# GENERATION_MODEL: Used for resume generation (default: gemini-3.5-flash-lite, override: gemini-3.8-flash)
# JUDGE_MODEL: Used for evaluation (default: gemini-3.1-flash-lite)
# Note: GENERATION_MODEL and JUDGE_MODEL must differ.
GENERATION_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.1-flash-lite
GENERATION_TEMPERATURE=0.3
JUDGE_TEMPERATURE=0.0

# Embedding Configuration
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Storage and Directories
CHROMA_PERSIST_DIR=./chroma_db
OUTPUT_DIR=./output
TEMPLATES_DIR=./templates
KNOWLEDGE_BASE_DIR=./src/knowledge_base
CANDIDATE_PROFILE_PATH=./data/candidate_profile.yaml
