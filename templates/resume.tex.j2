\documentclass[10pt,a4paper]{article}

% --- PACOTES BÁSICOS E TIPOGRAFIA ---
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[margin=0.46in, top=0.40in, bottom=0.40in]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{xcolor}

% --- CORES E LINKS ---
\definecolor{primary}{RGB}{20, 24, 33}      % Quase preto para máxima legibilidade
\definecolor{accent}{RGB}{25, 75, 140}      % Azul sóbrio profissional
\definecolor{subtext}{RGB}{85, 95, 110}     % Cinza escuro para datas/locais

\hypersetup{
    colorlinks=true,
    linkcolor=accent,
    urlcolor=accent,
    pdfauthor={<< header.full_name >>},
    pdftitle={Curriculum - << header.full_name >> - << target_job_title >>}
}

% --- FORMATAÇÃO DE PÁGINA E ESPAÇAMENTOS ---
\pagestyle{empty}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% --- FORMATAÇÃO DE SEÇÕES ---
\titleformat{\section}
  {\bfseries\large\color{accent}}
  {}{0em}
  {}[\vspace{1.5pt}\color{accent}\titlerule]

\titlespacing*{\section}{0pt}{4.5pt}{2.5pt}

% --- LISTAS E BULLETS COMPACTOS ---
\setlist[itemize]{
    leftmargin=1.2em,
    label={\small\textbullet},
    itemsep=0.8pt,
    topsep=0.5pt,
    parsep=0pt,
    partopsep=0pt
}

\begin{document}

% ==============================================================================
% CABEÇALHO / HEADER
% ==============================================================================
\begin{center}
    {\Huge\bfseries\color{primary} << header.full_name >>}\\[2.5pt]
    \small\color{subtext}
    << header.location >>
    \quad|\quad << header.phone >>
    \quad|\quad \href{mailto:<< header.email >>}{<< header.email >>}
    <% if header.linkedin_url and header.linkedin_url.strip() %>
    \quad|\quad \href{<< header.linkedin_url >>}{LinkedIn}
    <% endif %>
    <% if header.github_url and header.github_url.strip() %>
    \quad|\quad \href{<< header.github_url >>}{GitHub}
    <% endif %>
    <% if header.portfolio_url and header.portfolio_url.strip() %>
    \quad|\quad \href{<< header.portfolio_url >>}{Portfolio}
    <% endif %>
\end{center}
\vspace{-6pt}

% ==============================================================================
% OBJETIVO / RESUMO PROFISSIONAL
% ==============================================================================
<% if objective_or_summary %>
\section{<< labels.objective >>}
\small\color{primary}
<< objective_or_summary >>
<% endif %>

% ==============================================================================
% EDUCAÇÃO / FORMAÇÃO ACADÊMICA
% ==============================================================================
<% if education %>
\section{<< labels.education >>}
<% for edu in education %>
\noindent
\textbf{\color{primary} << edu.degree >>}, << edu.institution >><% if edu.location %> -- << edu.location >><% endif %> \hfill {\small\color{subtext} << edu.period|replace(' - ', ' -- ') >>}
<% if edu.highlights %>
\begin{itemize}
    <% for highlight in edu.highlights %>
    \item \small << highlight >>
    <% endfor %>
\end{itemize}
<% else %>
\vspace{2pt}
<% endif %>
<% endfor %>
<% endif %>

% ==============================================================================
% EXPERIÊNCIA PROFISSIONAL / ACADÊMICA
% ==============================================================================
<% if experiences %>
\section{<< labels.experience >>}
<% for exp in experiences %>
\noindent
\textbf{\color{primary} << exp.title >>}, << exp.organization >> \hfill {\small\color{subtext} << exp.period|replace(' - ', ' -- ') >>}
<% if exp.location %>
\newline {\footnotesize\color{subtext} << exp.location >>}
<% endif %>
<% if exp.technologies %>
\newline {\footnotesize\textbf{<< labels.technologies >>} \textit{<< exp.technologies|join(', ') >>}}
<% endif %>
<% if exp.bullets %>
\begin{itemize}
    <% for bullet in exp.bullets %>
    \item \small << bullet >>
    <% endfor %>
\end{itemize}
<% else %>
\vspace{2pt}
<% endif %>
<% endfor %>
<% endif %>

% ==============================================================================
% PROJETOS EM DESTAQUE
% ==============================================================================
<% if projects %>
\section{<< labels.projects >>}
<% for proj in projects %>
\noindent
\textbf{\color{primary} << proj.name >>}
<% if proj.url and proj.url.strip() %>
\hfill {\footnotesize\href{<< proj.url >>}{<< labels.view_project >>}}
<% endif %>
<% if proj.technologies %>
\newline {\footnotesize\textbf{<< labels.stack >>} \textit{<< proj.technologies|join(', ') >>}}
<% endif %>
<% if proj.bullets %>
\begin{itemize}
    <% for bullet in proj.bullets %>
    \item \small << bullet >>
    <% endfor %>
\end{itemize}
<% else %>
\vspace{2pt}
<% endif %>
<% endfor %>
<% endif %>

% ==============================================================================
% HABILIDADES TÉCNICAS
% ==============================================================================
<% if skills %>
\section{<< labels.skills >>}
\small
<% for skill_cat in skills %>
\noindent\textbf{<< skill_cat.category_name >>:} << skill_cat.skills|join(', ') >>\\[1.5pt]
<% endfor %>
<% endif %>

% ==============================================================================
% IDIOMAS E CERTIFICAÇÕES
% ==============================================================================
<% if languages or certifications %>
<% if languages and certifications %>
\section{<< labels.languages_certs >>}
<% elif languages %>
\section{<< labels.languages_only >>}
<% else %>
\section{<< labels.certifications_only >>}
<% endif %>
\small
<% if languages %>
<% if certifications %>
\noindent\textbf{<< labels.languages >>}
<% else %>
\noindent
<% endif %>
<% for lang in languages %>
<< lang.formatted | default(lang.language ~ ' (' ~ lang.proficiency ~ ')') >><% if not loop.last %>, <% endif %>
<% endfor %><% if certifications %>\\[1.5pt]<% endif %>
<% endif %>
<% if certifications %>
\noindent\textbf{<< labels.certifications >>} << certifications|join('; ') >>
<% endif %>
<% endif %>

\end{document}
